<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.car.systembar.base.CarSystemBarView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:systemui="http://schemas.android.com/apk/prv/res/com.android.systemui"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:gravity="center"
    android:padding="@*com.android.systemui:dimen/split_system_bar_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@*com.android.systemui:drawable/split_system_bar_background"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="horizontal">

        <com.android.systemui.car.systembar.appgrid.AppGridButton
            android:id="@+id/grid_nav"
            android:contentDescription="@*com.android.systemui:string/system_bar_applications_label"
            style="@*com.android.systemui:style/SystemBarButton"
            systemui:componentNames="@*com.android.systemui:string/config_appGridComponentName"
            systemui:highlightWhenSelected="true"
            systemui:icon="@*com.android.systemui:drawable/car_ic_apps"
            systemui:intent="@*com.android.systemui:string/system_bar_app_drawer_intent"
            systemui:clearBackStack="@*com.android.systemui:bool/config_enableClearBackStack"
            systemui:systemBarDisableFlags="home"/>

        <com.android.systemui.car.systembar.base.CarSystemBarButton
            android:contentDescription="Quick controls"
            style="@*com.android.systemui:style/SystemBarButton"
            systemui:componentNames="com.android.mysystemapp/.SystemUiPanelActivity"
            systemui:highlightWhenSelected="true"
            systemui:icon="@*com.android.systemui:drawable/car_ic_debug"
            systemui:intent="intent:#Intent;action=com.android.mysystemapp.action.OPEN_COCKPIT;component=com.android.mysystemapp/.SystemUiPanelActivity;launchFlags=0x14000000;end"
            systemui:systemBarDisableFlags="home"/>

        <com.android.systemui.car.flexibleui.layout.CarSystemBarFrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@*com.android.systemui:dimen/dock_container_margin"
            systemui:controller="com.android.systemui.car.systembar.dock.DockViewControllerWrapper">
            <com.android.car.docklib.view.DockView
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </com.android.systemui.car.flexibleui.layout.CarSystemBarFrameLayout>

        <com.android.systemui.car.systembar.base.CarSystemBarButton
            android:id="@+id/control_center_nav"
            android:contentDescription="@*com.android.systemui:string/system_bar_control_center_label"
            style="@*com.android.systemui:style/SystemBarButton"
            android:visibility="gone"
            systemui:highlightWhenSelected="true"
            systemui:icon="@*com.android.systemui:drawable/car_ic_control_center"
            systemui:intent="intent:#Intent;action=android.intent.action.MAIN;package=com.android.car.multidisplay.controlcenter;component=com.android.car.multidisplay.controlcenter/.ControlCenterActivity;B.BOTTOM_BAR_LAUNCH=true;end"
            systemui:componentNames="com.android.car.multidisplay.controlcenter/.ControlCenterActivity"
            systemui:controller="com.android.systemui.car.systembar.controlcenter.ControlCenterButtonController"/>

        <com.android.systemui.car.systembar.assistant.AssistantButton
            android:id="@+id/assistant"
            android:contentDescription="@*com.android.systemui:string/system_bar_assistant_label"
            style="@*com.android.systemui:style/SystemBarButton"
            systemui:highlightWhenSelected="true"
            systemui:icon="@*com.android.systemui:drawable/ic_mic_light"/>

        <com.android.systemui.car.systembar.base.CarSystemBarButton
            android:id="@+id/home"
            android:contentDescription="@*com.android.systemui:string/system_bar_home_label"
            style="@*com.android.systemui:style/SystemBarButton"
            systemui:componentNames="@*com.android.systemui:string/config_homeComponentName"
            systemui:panelNames="@*com.android.systemui:string/config_homePanelVisibilities"
            systemui:highlightWhenSelected="true"
            systemui:icon="@*com.android.systemui:drawable/car_ic_home"
            systemui:intent="intent:#Intent;action=android.intent.action.MAIN;category=android.intent.category.HOME;launchFlags=0x14000000;end"
            systemui:systemBarDisableFlags="home"
            systemui:controller="com.android.systemui.car.systembar.home.HomeButtonController"/>
    </LinearLayout>
</com.android.systemui.car.systembar.base.CarSystemBarView>
